<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- build-app.sh puts in the version: @VERSION@ is the whole version, @SHORT@ the numbers only. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Laser Level Webcam</string>
    <key>CFBundleExecutable</key>
    <string>laser-level-webcam</string>
    <key>CFBundleGetInfoString</key>
    <string>Laser Level Webcam @VERSION@</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.bhowiebkr.laser-level-webcam</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Laser Level Webcam</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@SHORT@</string>
    <key>CFBundleVersion</key>
    <string>@SHORT@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSCameraUsageDescription</key>
    <string>Laser Level Webcam reads where the laser line falls on the camera's sensor.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (c) 2023-2026 Bryan Howard. MIT License.</string>
</dict>
</plist>
